# Copy to .env.local and fill in real values. NEVER commit .env.local.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx            # server only, never exposed to the browser
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DIRECT_DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres  # migrations & pg-boss

# --- App ---
APP_URL=http://localhost:3000
APP_ENCRYPTION_KEY=<32-byte base64>          # openssl rand -base64 32; encrypts provider credentials at rest
DEFAULT_TIMEZONE=Asia/Colombo
DEFAULT_CURRENCY=LKR
LOG_LEVEL=info                               # fatal | error | warn | info | debug | trace

# --- Tests ---
# Disposable Postgres for integration tests ONLY (it is migrated/reset freely).
# `docker compose --profile localdb up -d` provides this one:
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:54329/pos_test

# --- PDF ---
GOTENBERG_URL=http://localhost:3001

# --- Email (choose one; per-tenant settings override in Admin) ---
EMAIL_DRIVER=console                         # console | smtp | resend
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
RESEND_API_KEY=
EMAIL_FROM="Demo Café <no-reply@example.com>"

# --- SMS (choose one; per-tenant settings override in Admin) ---
SMS_DRIVER=console                           # console | http | twilio
SMS_HTTP_URL=
SMS_HTTP_API_KEY=
SMS_SENDER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- Monitoring (optional) ---
SENTRY_DSN=

{
  "name": "pos-platform",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "turbo run dev --filter=web --filter=worker",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter web test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @pos/db db:generate",
    "db:migrate": "pnpm --filter @pos/db db:migrate",
    "db:seed": "pnpm --filter @pos/db db:seed",
    "db:reset": "pnpm --filter @pos/db db:reset",
    "check:env": "pnpm --filter @pos/config check:env"
  },
  "devDependencies": {
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "turbo": "2.11.11",
    "typescript": "5.9.3"
  }
}

{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env.local"],
  "globalEnv": ["NODE_ENV", "CI"],
  "globalPassThroughEnv": [
    "NEXT_PUBLIC_*",
    "SUPABASE_*",
    "DATABASE_URL",
    "DIRECT_DATABASE_URL",
    "TEST_DATABASE_URL",
    "APP_*",
    "DEFAULT_*",
    "GOTENBERG_URL",
    "EMAIL_*",
    "SMTP_*",
    "RESEND_API_KEY",
    "SMS_*",
    "TWILIO_*",
    "SENTRY_DSN",
    "LOG_LEVEL",
    "SKIP_ENV_VALIDATION"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": { "cache": false, "persistent": true },
    "lint": {},
    "typecheck": {},
    "test": { "outputs": [] }
  }
}
